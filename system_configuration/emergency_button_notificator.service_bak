[Unit]
Description=Home Emergency Button Agent - Sends alerts when the emergency button is pressed
Documentation=https://github.com/WaDoMa/HomeEmergencyButton/README.md
After=network.target
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
ExecStart=/home/pi2/HomeEmergencyButton/.venv/bin/python3 /home/pi2/HomeEmergencyButton/script/emergency_button_notificator.py
User=pi2
StandardOutput=journal
StandardError=journal
Type=idle
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target

